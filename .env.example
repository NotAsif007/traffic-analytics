# =============================================================================
# Traffic Analytics — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=traffic-analytics
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | console

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins. Use * for development only.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS
# ---------------------------------------------------------------------------
# Full async DSN used by the application.
DATABASE_URL=postgresql+asyncpg://traffic_user:traffic_pass@localhost:5432/traffic_db

# Sync DSN used only by Alembic CLI (migrations run synchronously).
ALEMBIC_DATABASE_URL=postgresql+psycopg2://traffic_user:traffic_pass@localhost:5432/traffic_db

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Redis & Event Bus
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Stitch MCP Configuration (Optional)
# ---------------------------------------------------------------------------
# STITCH_API_KEY=your_stitch_api_key_here

