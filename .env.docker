# Docker Compose Environment Configuration
# Copy this to .env if running with: docker compose up --build

APP_NAME=traffic-analytics
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

DATABASE_URL=postgresql+asyncpg://traffic_user:traffic_pass@db:5432/traffic_db
ALEMBIC_DATABASE_URL=postgresql+psycopg2://traffic_user:traffic_pass@db:5432/traffic_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

REDIS_URL=redis://redis:6379/0

POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=traffic_pass
POSTGRES_DB=traffic_db
